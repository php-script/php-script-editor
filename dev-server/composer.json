{
    "name": "php-script/editor-dev-server",
    "description": "Tiny PHP backend for the php-script editor playground and e2e tests.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "php-script/php-script": "^2.0"
    },
    "autoload": {
        "psr-4": { "DevServer\\": "src/" }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
        "export-config": "php bin/export-config.php"
    },
    "config": { "sort-packages": true }
}
