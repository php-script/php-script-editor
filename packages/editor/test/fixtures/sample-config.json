{
  "definition": {
    "keywords": [
      "if",
      "else",
      "for",
      "foreach",
      "as",
      "echo",
      "return",
      "true",
      "false",
      "null",
      "LINEBREAK"
    ],
    "loopKeywords": ["break", "continue"],
    "allowedFunctions": ["strtoupper", "strtolower", "count", "round", "implode", "str_contains"],
    "contextVariables": ["user", "items", "taxRate"],
    "operators": [
      "==",
      "===",
      "!=",
      "!==",
      "=",
      ".",
      "+",
      "-",
      "*",
      "/",
      "%",
      ">",
      "<",
      ">=",
      "<=",
      "&&",
      "||",
      "!",
      "++",
      "--",
      ":"
    ],
    "symbols": "[=><!~?&|+\\-*/^%.,;()\\{}\\[\\]]",
    "tokenizer": {
      "root": [
        [
          "[a-zA-Z_]\\w*",
          {
            "cases": {
              "@keywords": "keyword",
              "@loopKeywords": "keyword",
              "@allowedFunctions": "predefined",
              "@contextVariables": "variable.predefined",
              "@default": "identifier"
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        ["[{}()\\[\\]]", "@brackets"],
        ["[<>](?!@symbols)", "@brackets"],
        [
          "@symbols",
          {
            "cases": {
              "@operators": "operator",
              "@default": ""
            }
          }
        ],
        ["\\d+(\\.\\d+)?", "number"],
        ["\"", "string.quote", "@string_double"],
        ["'", "string.quote", "@string_single"]
      ],
      "whitespace": [
        ["[ \\t\\r\\n]+", ""],
        ["\\/\\/.*$", "comment"]
      ],
      "string_double": [
        ["[^\\\\\"]+", "string"],
        ["\\\\.", "string.escape"],
        ["\"", "string.quote", "@pop"]
      ],
      "string_single": [
        ["[^\\\\']+", "string"],
        ["\\\\.", "string.escape"],
        ["'", "string.quote", "@pop"]
      ]
    }
  },
