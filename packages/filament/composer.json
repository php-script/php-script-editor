{
    "name": "php-script/editor-filament",
    "description": "Filament 5 form field (PhpScriptEditor) for the <php-script-editor> web component (php-script v2).",
    "keywords": [
        "php-script",
        "laravel",
        "filament",
        "monaco",
        "editor"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Robert Kummer",
            "email": "post@robert-kummer.de"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../laravel",
            "options": {
                "symlink": true,
                "versions": {
                    "php-script/editor-laravel": "2.0.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "php-script/editor-laravel": "^2.0@dev",
        "php-script/php-script": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PhpScript\\Editor\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpScript\\Editor\\Filament\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpScript\\Editor\\Filament\\PhpScriptEditorFilamentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
