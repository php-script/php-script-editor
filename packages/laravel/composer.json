{
    "name": "php-script/editor-laravel",
    "description": "Laravel integration (Blade component, config endpoint, lint response, validation rule) for the <php-script-editor> web component (php-script v2).",
    "keywords": [
        "php-script",
        "laravel",
        "monaco",
        "editor",
        "blade"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Robert Kummer",
            "email": "post@robert-kummer.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "php-script/php-script": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "php-script/editor-filament": "PhpScriptEditor form field for Filament 5."
    },
    "autoload": {
        "psr-4": {
            "PhpScript\\Editor\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpScript\\Editor\\Laravel\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpScript\\Editor\\Laravel\\PhpScriptEditorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "build-asset": "@php bin/build-asset.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
