{
  "name": "php-script-monaco-editor",
  "version": "1.0.0",
  "description": "Pre-configured Monaco Editor for php-script language with server-side rendered configuration support",
  "type": "commonjs",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    },
    "./language": {
      "types": "./dist/types/language/index.d.ts",
      "require": "./dist/cjs/language/index.cjs",
      "import": "./dist/esm/language/index.mjs"
    },
    "./config": {
      "types": "./dist/types/config/index.d.ts",
      "require": "./dist/cjs/config/index.cjs",
      "import": "./dist/esm/config/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch src",
    "dev": "tsup --watch src",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "keywords": [
    "monaco",
    "monaco-editor",
    "php-script",
    "editor",
    "code-editor",
    "syntax-highlighting",
    "code-completion",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "monaco-editor": "^0.50.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": false
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.2.0",
    "monaco-editor": "^0.50.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/php-script-monaco-editor"
  }
}
